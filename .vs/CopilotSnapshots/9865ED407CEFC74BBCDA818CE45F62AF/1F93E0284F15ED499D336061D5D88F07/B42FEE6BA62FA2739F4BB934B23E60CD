        public async void Main_Form_Load(object sender, EventArgs e)
        {
            ucMainForm uc = new ucMainForm();
            loadUserControl(uc);

            using (var db = new QL_SANBONG_MINIDatacontext())
            {
                NhanVienEntity user = await db.NhanViens.Where(nv => nv.manv == this.manv_logged).FirstOrDefaultAsync();

                if (user == null)
                {
                    MessageBox.Show("Lỗi không tìm thấy user", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                // Hiển thị tên user
                lblUserInfo.Text = "Hello, " + user.hoten;

                // Kiểm tra xem user là nhân viên hay quản lý
                if (user.macv == 2) // Nhân viên
                {
                    // Ẩn chức năng xem thống kê và quản lý nhân viên
                    btnNhanVien.Visible = false;
                    btnThongKe.Visible = false;
                }    
            }
        }

        /// <summary>
        /// Load UserControl vào panel chính với 3 chế độ layout
        /// </summary>
        /// <param name="uc">UserControl cần load</param>
        /// <param name="layoutMode">
        /// "Fill" - Lấp đầy toàn bộ (mặc định)
        /// "Center" - Căn giữa với kích thước cố định
        /// "CenterWithPadding" - Căn giữa với padding xung quanh
        /// </param>
        private void loadUserControl(UserControl uc, string layoutMode = "Fill")
        {
            pnlMainContent.Controls.Clear();

            switch (layoutMode)
            {
                case "Fill":
                    // Chế độ 1: Lấp đầy toàn bộ panel (Responsive 100%)
                    uc.Dock = DockStyle.Fill;
                    pnlMainContent.Controls.Add(uc);
                    break;

                case "Center":
                    // Chế độ 2: Căn giữa với kích thước cố định
                    uc.Anchor = AnchorStyles.None;
                    uc.Location = new Point(
                        (pnlMainContent.Width - uc.Width) / 2,
                        (pnlMainContent.Height - uc.Height) / 2
                    );
                    pnlMainContent.Controls.Add(uc);
                    
                    // Đăng ký event để tự động căn giữa khi resize
                    pnlMainContent.Resize += (s, e) =>
                    {
                        uc.Location = new Point(
                            (pnlMainContent.Width - uc.Width) / 2,
                            (pnlMainContent.Height - uc.Height) / 2
                        );
                    };
                    break;

                case "CenterWithPadding":
                    // Chế độ 3: Căn giữa với TableLayoutPanel (Chuyên nghiệp nhất)
                    TableLayoutPanel tableLayout = new TableLayoutPanel
                    {
                        Dock = DockStyle.Fill,
                        ColumnCount = 3,
                        RowCount = 3,
                        BackColor = pnlMainContent.BackColor
                    };

                    // Cấu hình 3 cột: 10% - 80% - 10%
                    tableLayout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 10F));
                    tableLayout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 80F));
                    tableLayout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 10F));

                    // Cấu hình 3 hàng: 10% - 80% - 10%
                    tableLayout.RowStyles.Add(new RowStyle(SizeType.Percent, 10F));
                    tableLayout.RowStyles.Add(new RowStyle(SizeType.Percent, 80F));
                    tableLayout.RowStyles.Add(new RowStyle(SizeType.Percent, 10F));

                    // Đặt UserControl vào ô giữa (hàng 1, cột 1)
                    uc.Dock = DockStyle.Fill;
                    tableLayout.Controls.Add(uc, 1, 1);

                    pnlMainContent.Controls.Add(tableLayout);
                    break;

                default:
                    // Mặc định: Fill
                    uc.Dock = DockStyle.Fill;
                    pnlMainContent.Controls.Add(uc);
                    break;
            }

            uc.BringToFront();
        }

