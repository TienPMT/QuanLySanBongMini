        private void Main_Form_Load(object sender, EventArgs e)
        {
            try
            {
                using (var db = new QL_SANBONG_MINIDatacontext())
                {
                    // Sử dụng alias để tránh conflict
                    NhanVienEntity user = db.NhanViens
                        .FirstOrDefault(nv => nv.manv == this.manv_logged);

                    if (user == null)
                    {
                        MessageBox.Show("Lỗi không tìm thấy user", "Error", 
                            MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }

                    // Hiển thị tên user ở sidebar
                    lblUserInfo.Text = "👤 " + user.hoten;

                    // Hiển thị welcome message cá nhân hóa
                    string greeting = GetGreeting();
                    lblWelcomeTitle.Text = $"👋 {greeting}, {user.hoten}!");

                    // Kiểm tra xem user là nhân viên hay quản lý
                    if (user.macv == 2) // Nhân viên
                    {
                        // Ẩn chức năng xem thống kê và quản lý nhân viên
                        btnNhanVien.Visible = false;
                        btnThongKe.Visible = false;
                        
                        // Cập nhật welcome message cho nhân viên
                        lblWelcomeMessage.Text = "Chúc bạn một ngày làm việc hiệu quả!\n" +
                            "Hãy chọn chức năng từ menu bên trái để bắt đầu.";
                    }
                    else // Quản lý
                    {
                        lblWelcomeMessage.Text = "Chào mừng trở lại với hệ thống quản lý!\n" +
                            "Bạn có toàn quyền truy cập các chức năng của hệ thống.";
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi tải thông tin người dùng:\n{ex.Message}", 
                    "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // Phương thức lấy lời chào theo thời gian
        private string GetGreeting()
        {
            int hour = DateTime.Now.Hour;
            
            if (hour >= 5 && hour < 12)
                return "Chào buổi sáng";
            else if (hour >= 12 && hour < 18)
                return "Chào buổi chiều";
            else
                return "Chào buổi tối";
        }

        // Hiển thị welcome panel
        private void ShowWelcomePanel()
        {
            pnlWelcome.Visible = true;
        }

        // Ẩn welcome panel khi load UserControl
        private void HideWelcomePanel()
        {
            pnlWelcome.Visible = false;
        }

        private void loadUserControl(UserControl uc)
        {
            pnlMainContent.Controls.Clear();
            
            uc.Dock = DockStyle.Fill;
            pnlMainContent.Controls.Add(uc);
            uc.BringToFront();
        }

        private void Main_Form_FormClosing(object sender, FormClosingEventArgs e)
        {
            // Dừng timer khi đóng form
            if (clockTimer != null)
            {
                clockTimer.Stop();
                clockTimer.Dispose();
            }
            
            Application.Exit();
        }
